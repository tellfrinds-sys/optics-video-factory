    {"id":"8104c7c1-3ab7-454f-9d88-1e9b3083cd20","name":"تحليل الرد","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,272],"parameters":{"jsCode":"const raw = JSON.stringify($input.first().json);\nconst item = $input.first().json;\nconst cb = item?.callback_query ?? item?.callbackQuery ?? item?.body?.callback_query ?? null;\n\nif (!cb) {\n  return [{ json: { error: true, raw_data: raw } }];\n}\n\nconst parts = (cb.data || '').split(':');\nconst map = {approve: 'approved', edit: 'changes_requested', reject: 'rejected'};\n\nreturn [{\n  json: {\n    action: parts[0],\n    video_uid: Number(parts[1]),\n    approval_state: map[parts[0]] || 'unknown',\n    callback_query_id: cb.id,\n    from_chat_id: cb.message?.chat?.id,\n    message_id: cb.message?.message_id\n  }\n}];"}},
