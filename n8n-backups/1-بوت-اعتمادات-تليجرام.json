    {"id":"f869ac42-14ba-43d8-8475-f8aee32ac8f8","name":"استخراج النص المصحح","type":"n8n-nodes-base.code","typeVersion":2,"position":[520,460],"parameters":{"jsCode":"const msg = $input.first().json.message;\nconst replyText = (msg.reply_to_message && msg.reply_to_message.text) || '';\nconst match = replyText.match(/المراجعة رقم\\s*([0-9a-fA-F-]{8,36})/);\nconst output_uid = match ? match[1] : null;\n\nlet corrected = msg.text || '';\nconst quoteHeaderPattern = /^النص الحالي \\(المراجعة رقم[^\\n]*\\)\\n+/;\ncorrected = corrected.replace(quoteHeaderPattern, '').trim();\n\nfunction simpleHash(str) {\n  let h = 0;\n  for (let i = 0; i < str.length; i++) { h = (Math.imul(31, h) + str.charCodeAt(i)) | 0; }\n  return 'h' + Math.abs(h).toString(16) + '_' + str.length;\n}\nreturn [{ json: { output_uid: output_uid, corrected_text: corrected, output_hash: simpleHash(corrected), chat_id: msg.chat.id } }];"}},
